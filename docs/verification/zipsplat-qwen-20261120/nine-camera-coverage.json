    "orbit_pairwise_angle": "Shortest unsigned circular difference of orbit_yaw, in [0,180] degrees.",
    "largest_gap": "Largest cyclic difference between sorted orbit azimuth samples, including wrap-around. This is a sample gap, not the unobserved solid angle after accounting for each camera field of view.",
    "reliability": "Read fitted-target ray residuals and center singular values together; orbit diagnostics may be unreliable if the sight lines do not converge on one object.",
    "nominal_guide_angles_used_for_accuracy": false,
    "rotation_scale_or_alignment_changed": false,
    "camera_centers_fitted_against_scene_geometry": false
  },
