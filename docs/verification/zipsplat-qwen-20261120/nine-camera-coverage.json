    "comparison_policy": "Identical formulas to the smoke4/six/nine camera_report export; each branch is expressed relative to its own estimated first camera.",
    "forward_axis": "OpenCV c2w rotation column 2 (+Z)",
    "forward_pairwise_angle": "degrees(acos(clip(d_i dot d_j,-1,1))), copied and verified against exported diagnostics; tiny float rotation errors on diagonal are not interpreted.",
    "look_target": "Least-squares common point of infinite optical-axis lines: solve sum(I-d*d.T)*target=sum((I-d*d.T)*camera_center).",
